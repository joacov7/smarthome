# ============================================================
#  GuayCore — Variables de entorno
#  Copiar a .env y completar con valores reales
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL + TimescaleDB ─────────────────────────────────
POSTGRES_DB=guaycore
POSTGRES_USER=guay
POSTGRES_PASSWORD=guay_dev_pass
DATABASE_URL=postgresql://guay:guay_dev_pass@localhost:5432/guaycore

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=redis_dev_pass
REDIS_URL=redis://:redis_dev_pass@localhost:6379

# ── EMQX MQTT Broker ─────────────────────────────────────────
MQTT_URL=mqtt://localhost:1883
MQTT_BACKEND_USER=guaycore_backend
MQTT_BACKEND_PASS=backend_secret
EMQX_DASHBOARD_PASS=guay_emqx_admin

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Notificaciones ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TELEGRAM_BOT_TOKEN=
