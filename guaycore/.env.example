# ============================================================
#  GuayCore — Variables de entorno
#  Copiar a .env y completar con valores reales
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL + TimescaleDB ─────────────────────────────────
POSTGRES_DB=guaycore
POSTGRES_USER=guay
POSTGRES_PASSWORD=change_in_production
DATABASE_URL=postgresql://guay:change_in_production@localhost:5432/guaycore

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=change_in_production
REDIS_URL=redis://:change_in_production@localhost:6379

# ── EMQX MQTT Broker ─────────────────────────────────────────
MQTT_URL=mqtt://localhost:1883
MQTT_BACKEND_USER=guaycore_backend
MQTT_BACKEND_PASS=change_in_production
EMQX_DASHBOARD_PASS=change_in_production

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_random_32_char_secret
JWT_REFRESH_SECRET=change_this_to_another_32_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Notificaciones ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TELEGRAM_BOT_TOKEN=
