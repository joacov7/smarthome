# ── GuayCore Frontend ─────────────────────────────────────────
# Copiar a .env.local para desarrollo local
# En Vercel: configurar como Environment Variables en el dashboard

# URL del backend NestJS (sin trailing slash)
# Local:      http://localhost:3000/api/v1
# Producción: https://api.tudominio.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# URL base del backend para WebSocket (sin /api/v1)
# El socket.io-client agrega /ws al final automáticamente
# Local:      http://localhost:3000
# Producción: https://api.tudominio.com
NEXT_PUBLIC_WS_URL=http://localhost:3000
